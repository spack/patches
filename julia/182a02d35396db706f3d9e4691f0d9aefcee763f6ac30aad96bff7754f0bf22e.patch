From f391048978428f629edbcd9f372705eb91a44c55 Mon Sep 17 00:00:00 2001
From: Jason Hafer <jhafer@mathworks.com>
Date: Fri, 3 Apr 2026 09:59:06 -0400
Subject: [PATCH 16/19] [InstCombine] Add user-count bailout to
 isAllocSiteRemovable
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

isAllocSiteRemovable() walks all transitive users of an allocation site, but sites with many users are almost never removable. Bail out after visiting 2048 users, and defer WeakTrackingVH conversion until the site is known to be removable.

This backports llvm/llvm-project#190347 to release/20.x. The port keeps this branch’s bool-returning isAllocSiteRemovable signature and indexed Users loop.

(cherry picked from commit 34a80c90e815c4b77cb963489618ba24528ea0cc, resolving conflicts against release/20.x)

Fixes JuliaLang/julia#60313.
---
 .../InstCombine/InstructionCombining.cpp      | 19 +++++++++++---
 .../allocsite-removable-few-users.ll          | 25 +++++++++++++++++++
 2 files changed, 41 insertions(+), 3 deletions(-)
 create mode 100644 llvm/test/Transforms/InstCombine/allocsite-removable-few-users.ll

diff --git a/llvm/lib/Transforms/InstCombine/InstructionCombining.cpp b/llvm/lib/Transforms/InstCombine/InstructionCombining.cpp
index 0f5e867877da2..575d6da4d9ae5 100644
--- a/llvm/lib/Transforms/InstCombine/InstructionCombining.cpp
+++ b/llvm/lib/Transforms/InstCombine/InstructionCombining.cpp
@@ -142,6 +142,11 @@ static cl::opt<unsigned>
 MaxArraySize("instcombine-maxarray-size", cl::init(1024),
              cl::desc("Maximum array size considered when doing a combine"));
 
+static cl::opt<unsigned> MaxAllocSiteRemovableUsers(
+    "instcombine-max-allocsite-removable-users", cl::Hidden, cl::init(2048),
+    cl::desc("Maximum number of users to visit in alloc-site "
+             "removability analysis"));
+
 // FIXME: Remove this flag when it is no longer necessary to convert
 // llvm.dbg.declare to avoid inaccurate debug info. Setting this to false
 // increases variable availability at the cost of accuracy. Variables that
@@ -3214,7 +3219,7 @@ static bool isRemovableWrite(CallBase &CB, Value *UsedV,
 }
 
 static bool isAllocSiteRemovable(Instruction *AI,
-                                 SmallVectorImpl<WeakTrackingVH> &Users,
+                                 SmallVectorImpl<Instruction *> &Users,
                                  const TargetLibraryInfo &TLI) {
   SmallVector<Instruction*, 4> Worklist;
   const std::optional<StringRef> Family = getAllocationFamily(AI, &TLI);
@@ -3224,6 +3229,8 @@ static bool isAllocSiteRemovable(Instruction *AI,
     Instruction *PI = Worklist.pop_back_val();
     for (User *U : PI->users()) {
       Instruction *I = cast<Instruction>(U);
+      if (Users.size() >= MaxAllocSiteRemovableUsers)
+        return false;
       switch (I->getOpcode()) {
       default:
         // Give up the moment we see something we can't handle.
@@ -3350,7 +3357,11 @@ Instruction *InstCombinerImpl::visitAllocSite(Instruction &MI) {
   // outputs of a program (when we convert a malloc to an alloca, the fact that
   // the allocation is now on the stack is potentially visible, for example),
   // but we believe in a permissible manner.
-  SmallVector<WeakTrackingVH, 64> Users;
+  //
+  // Collect into Instruction* first to avoid expensive WeakTrackingVH
+  // register/unregister overhead; convert to WeakTrackingVH only when the
+  // site is actually removable.
+  SmallVector<Instruction *, 64> RawUsers;
 
   // If we are removing an alloca with a dbg.declare, insert dbg.value calls
   // before each store.
@@ -3362,7 +3373,9 @@ Instruction *InstCombinerImpl::visitAllocSite(Instruction &MI) {
     DIB.reset(new DIBuilder(*MI.getModule(), /*AllowUnresolved=*/false));
   }
 
-  if (isAllocSiteRemovable(&MI, Users, TLI)) {
+  bool Removable = isAllocSiteRemovable(&MI, RawUsers, TLI);
+  if (Removable) {
+    SmallVector<WeakTrackingVH, 64> Users(RawUsers.begin(), RawUsers.end());
     for (unsigned i = 0, e = Users.size(); i != e; ++i) {
       // Lowering all @llvm.objectsize calls first because they may
       // use a bitcast/GEP of the alloca we are removing.
diff --git a/llvm/test/Transforms/InstCombine/allocsite-removable-few-users.ll b/llvm/test/Transforms/InstCombine/allocsite-removable-few-users.ll
new file mode 100644
index 0000000000000..14f0940b182a7
--- /dev/null
+++ b/llvm/test/Transforms/InstCombine/allocsite-removable-few-users.ll
@@ -0,0 +1,25 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt -passes=instcombine -S < %s | FileCheck %s --check-prefix=OPT
+; RUN: opt -passes=instcombine -instcombine-max-allocsite-removable-users=1 -S < %s | FileCheck %s --check-prefix=NOOPT
+
+; Test that alloca with few users is still removed by
+; isAllocSiteRemovable (not blocked by user-count bailout).
+; With a threshold of 1, the alloca is not removed.
+define i32 @test_few_users_still_removed() {
+; OPT-LABEL: @test_few_users_still_removed(
+; OPT-NEXT:    ret i32 0
+;
+; NOOPT-LABEL: @test_few_users_still_removed(
+; NOOPT-NEXT:    [[A:%.*]] = alloca [4 x i8], align 1
+; NOOPT-NEXT:    [[P1:%.*]] = getelementptr inbounds nuw i8, ptr [[A]], i64 1
+; NOOPT-NEXT:    store i8 0, ptr [[A]], align 1
+; NOOPT-NEXT:    store i8 1, ptr [[P1]], align 1
+; NOOPT-NEXT:    ret i32 0
+;
+  %a = alloca [4 x i8], align 1
+  %p0 = getelementptr inbounds [4 x i8], ptr %a, i64 0, i64 0
+  %p1 = getelementptr inbounds [4 x i8], ptr %a, i64 0, i64 1
+  store i8 0, ptr %p0, align 1
+  store i8 1, ptr %p1, align 1
+  ret i32 0
+}

From e27b78b90025363b8d526f79e914534a8a8ceb6b Mon Sep 17 00:00:00 2001
From: Tim Besard <tim.besard@gmail.com>
Date: Mon, 17 Aug 2026 15:56:39 +0200
Subject: [PATCH 17/19] [SROA] Reject illegal vector memset promotion

Vector promotion rewrites a memset byte pattern through an integer splat.
Reject promotion when the integer cannot be converted to the vector element
type, as with non-integral pointers.

This backports llvm/llvm-project#216772 (not yet merged upstream). Needed by
Julia, whose GC-tracked pointers live in the non-integral address space 10;
SROA would otherwise assert in convertValue ("Value not convertable to type").

The port drops the VScale argument to canConvertValue, which release/20.x
does not have yet.

Assisted-by: Codex (GPT-5)
Signed-off-by: Tim Besard <tim.besard@gmail.com>
---
 llvm/lib/Transforms/Scalar/SROA.cpp           |  5 +++++
 .../non-integral-pointer-vector-memset.ll     | 21 +++++++++++++++++++
 2 files changed, 26 insertions(+)
 create mode 100644 llvm/test/Transforms/SROA/non-integral-pointer-vector-memset.ll

diff --git a/llvm/lib/Transforms/Scalar/SROA.cpp b/llvm/lib/Transforms/Scalar/SROA.cpp
index e88c130cccf20..3b4db29e040b9 100644
--- a/llvm/lib/Transforms/Scalar/SROA.cpp
+++ b/llvm/lib/Transforms/Scalar/SROA.cpp
@@ -2074,6 +2074,11 @@ static bool isVectorPromotionViableForSlice(Partition &P, const Slice &S,
       return false;
     if (!S.isSplittable())
       return false; // Skip any unsplittable intrinsics.
+    if (isa<MemSetInst>(MI)) {
+      Type *SplatTy = Type::getIntNTy(Ty->getContext(), ElementSize * 8);
+      if (!canConvertValue(DL, SplatTy, Ty->getElementType()))
+        return false;
+    }
   } else if (IntrinsicInst *II = dyn_cast<IntrinsicInst>(U->getUser())) {
     if (!II->isLifetimeStartOrEnd() && !II->isDroppable())
       return false;
diff --git a/llvm/test/Transforms/SROA/non-integral-pointer-vector-memset.ll b/llvm/test/Transforms/SROA/non-integral-pointer-vector-memset.ll
new file mode 100644
index 0000000000000..9cba9b4ef1eea
--- /dev/null
+++ b/llvm/test/Transforms/SROA/non-integral-pointer-vector-memset.ll
@@ -0,0 +1,21 @@
+; RUN: opt -passes=sroa -S %s | FileCheck %s
+
+; Do not convert a memset byte pattern to a non-integral pointer when
+; vector-promoting an alloca partition.
+
+; CHECK-LABEL: define <2 x ptr addrspace(10)> @vector_memset(
+; CHECK-NOT: inttoptr
+; CHECK-NOT: ptrtoint
+
+target datalayout = "e-ni:10"
+
+declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)
+
+define <2 x ptr addrspace(10)> @vector_memset(<2 x ptr addrspace(10)> %v, i8 %byte) {
+  %a = alloca [2 x ptr addrspace(10)], align 8
+  store <2 x ptr addrspace(10)> %v, ptr %a, align 8
+  %p = getelementptr inbounds i8, ptr %a, i64 8
+  call void @llvm.memset.p0.i64(ptr %p, i8 %byte, i64 8, i1 false)
+  %r = load <2 x ptr addrspace(10)>, ptr %a, align 8
+  ret <2 x ptr addrspace(10)> %r
+}

