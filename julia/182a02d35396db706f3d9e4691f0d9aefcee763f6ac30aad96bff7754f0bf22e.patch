 llvm/lib/Analysis/LoopInfo.cpp                | 60 +++++++++++++-----
 .../Transforms/Scalar/SimpleLoopUnswitch.cpp  | 17 ++----
 llvm/lib/Transforms/Utils/LoopConstrainer.cpp |  7 +++
 .../Transforms/IRCE/pre_post_loops_clone.ll   | 61 +++++++++++++++++++
 5 files changed, 123 insertions(+), 28 deletions(-)
 create mode 100644 llvm/test/Transforms/IRCE/pre_post_loops_clone.ll

